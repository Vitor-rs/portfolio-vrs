---
interface Props {
    name: string;
    description: string;
    technologies: string[];
    url: string;
    stars?: number;
    language?: string | null;
}
const { name, description, technologies, url, stars, language } = Astro.props;
---
<article class="card hover:-translate-y-2 transition-all duration-500 p-6 rounded-lg shadow-lg flex flex-col h-full" role="listitem">
    <div class="flex items-start justify-between mb-3">
        <a
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xl font-bold text-dark dark:text-light hover:text-primary transition-colors duration-300 flex-1"
            aria-label={`Ver projeto ${name} no GitHub`}
        >
            {name}
        </a>
        {stars !== undefined && stars > 0 && (
            <div class="flex items-center gap-1 text-yellow-500 ml-2" aria-label={`${stars} estrelas no GitHub`}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/>
                </svg>
                <span class="text-sm font-medium">{stars}</span>
            </div>
        )}
    </div>

    <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 flex-1 line-clamp-3">
        {description}
    </p>

    <div class="mt-auto">
        {language && (
            <div class="mb-3 flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-primary"></span>
                <span class="text-sm text-gray-600 dark:text-gray-400">{language}</span>
            </div>
        )}
        <ul class="flex flex-wrap gap-2">
            {technologies.slice(0, 4).map((tech) => (
                <li class="text-xs bg-secondary/20 text-secondary dark:text-secondary border border-secondary/30 px-2 py-1 rounded-md font-medium">
                    {tech}
                </li>
            ))}
            {technologies.length > 4 && (
                <li class="text-xs text-gray-500 dark:text-gray-400 px-2 py-1">
                    +{technologies.length - 4}
                </li>
            )}
        </ul>
    </div>
</article>

<style>
    .card {
        background-color: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
</style>